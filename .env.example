# PORT and DATABASE_URL are used by the API.
PORT=3000
DATABASE_URL=postgresql://url_shortener:replace-with-local-password@localhost:5432/url_shortener

# These values configure the local PostgreSQL container. Keep them in sync
# with the credentials and database name used in DATABASE_URL.
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=url_shortener

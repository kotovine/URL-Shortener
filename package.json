{
  "name": "url-shortener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @url-shortener/web --filter @url-shortener/api dev",
    "dev:web": "pnpm --filter @url-shortener/web dev",
    "dev:api": "pnpm --filter @url-shortener/api dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.46.4"
  }
}
